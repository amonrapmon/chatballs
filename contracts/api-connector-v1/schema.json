{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chatballs:api-connector:v1",
  "title": "Chatballs API Connector v1 implemented wire shapes",
  "description": "Implementation-first, pre-GA. Top-level oneOf includes adapter->Chatballs ingress and Chatballs->adapter commands/acks. Endpoint direction and media/feature gates are described in openapi.json. Provider/network guarantees cannot be inferred from schema validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/MessageCreatedTextEvent"
    },
    {
      "$ref": "#/$defs/MessageCreatedMediaEvent"
    },
    {
      "$ref": "#/$defs/ObservedOutgoingEvent"
    },
    {
      "$ref": "#/$defs/EchoEvent"
    },
    {
      "$ref": "#/$defs/DeliveryReceipt"
    },
    {
      "$ref": "#/$defs/AdapterCommand"
    },
    {
      "$ref": "#/$defs/CommandAck"
    }
  ],
  "$defs": {
    "Identifier128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "Identifier256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "SourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^connection-[0-9]+$"
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "Timestamp": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC timestamp ending in Z; runtime also checks ISO parsing and UTC offset."
    },
    "ConversationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_chat_id"
      ],
      "properties": {
        "external_chat_id": {
          "$ref": "#/$defs/Identifier128"
        },
        "thread": {
          "type": "null"
        }
      }
    },
    "Sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_user_id"
      ],
      "properties": {
        "external_user_id": {
          "$ref": "#/$defs/Identifier128"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "avatar_ref": {
          "type": "null"
        },
        "phone": {
          "type": "null"
        }
      }
    },
    "AttachmentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "content_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Safe basename, no paths/quotes/control characters; runtime checks filename and extension."
        },
        "content_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "application/pdf"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "MessageText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_message_id",
        "direction",
        "origin",
        "actor",
        "kind",
        "text",
        "attachments"
      ],
      "properties": {
        "external_message_id": {
          "$ref": "#/$defs/Identifier128"
        },
        "direction": {
          "const": "inbound"
        },
        "origin": {
          "const": "external_observed"
        },
        "actor": {
          "const": "contact"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "html": {
          "type": "null"
        },
        "attachments": {
          "type": "array",
          "maxItems": 0,
          "items": false
        },
        "reply_to_external_message_id": {
          "type": "null"
        },
        "contact_share": {
          "type": "null"
        },
        "kind": {
          "const": "text"
        }
      }
    },
    "MessageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_message_id",
        "direction",
        "origin",
        "actor",
        "kind",
        "text",
        "attachments"
      ],
      "properties": {
        "external_message_id": {
          "$ref": "#/$defs/Identifier128"
        },
        "direction": {
          "const": "inbound"
        },
        "origin": {
          "const": "external_observed"
        },
        "actor": {
          "const": "contact"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "html": {
          "type": "null"
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/AttachmentManifest"
          }
        },
        "reply_to_external_message_id": {
          "type": "null"
        },
        "contact_share": {
          "type": "null"
        },
        "kind": {
          "const": "file"
        }
      }
    },
    "ObservedOutgoingMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_message_id",
        "direction",
        "origin",
        "actor",
        "kind",
        "text",
        "attachments"
      ],
      "properties": {
        "external_message_id": {
          "$ref": "#/$defs/Identifier128"
        },
        "direction": {
          "const": "outbound"
        },
        "origin": {
          "const": "external_observed"
        },
        "actor": {
          "const": "unknown"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "html": {
          "type": "null"
        },
        "attachments": {
          "type": "array",
          "maxItems": 0,
          "items": false
        },
        "reply_to_external_message_id": {
          "type": "null"
        },
        "contact_share": {
          "type": "null"
        },
        "kind": {
          "const": "text"
        }
      }
    },
    "EchoCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "const": "command_echo"
        },
        "command_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_message_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier128"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "command_id"
          ],
          "properties": {
            "command_id": {
              "$ref": "#/$defs/UUID"
            }
          }
        },
        {
          "required": [
            "external_message_id"
          ],
          "properties": {
            "external_message_id": {
              "$ref": "#/$defs/Identifier128"
            }
          }
        }
      ]
    },
    "ReceiptEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurred_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier256"
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "MessageCreatedTextEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "event",
        "conversation",
        "sender",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.event.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurred_at"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Identifier256"
            },
            "type": {
              "const": "message.created"
            },
            "occurred_at": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "conversation": {
          "$ref": "#/$defs/ConversationRoute"
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "message": {
          "$ref": "#/$defs/MessageText"
        }
      }
    },
    "MessageCreatedMediaEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "event",
        "conversation",
        "sender",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.event.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurred_at"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Identifier256"
            },
            "type": {
              "const": "message.created"
            },
            "occurred_at": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "conversation": {
          "$ref": "#/$defs/ConversationRoute"
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "message": {
          "$ref": "#/$defs/MessageFile"
        }
      }
    },
    "ObservedOutgoingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "event",
        "conversation",
        "sender",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.event.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurred_at"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Identifier256"
            },
            "type": {
              "const": "message.observed_outgoing"
            },
            "occurred_at": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "conversation": {
          "$ref": "#/$defs/ConversationRoute"
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "message": {
          "$ref": "#/$defs/ObservedOutgoingMessage"
        }
      }
    },
    "EchoEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "event",
        "conversation",
        "echo"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.event.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurred_at"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Identifier256"
            },
            "type": {
              "const": "message.echo"
            },
            "occurred_at": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "conversation": {
          "$ref": "#/$defs/ConversationRoute"
        },
        "echo": {
          "$ref": "#/$defs/EchoCorrelation"
        }
      }
    },
    "DeliveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "event",
        "command_id",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.receipt.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "event": {
          "$ref": "#/$defs/ReceiptEvent"
        },
        "command_id": {
          "$ref": "#/$defs/UUID"
        },
        "status": {
          "enum": [
            "PROVIDER_SENT",
            "DELIVERED",
            "FAILED"
          ]
        },
        "provider_message_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 0
            },
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "failure_code"
            ],
            "properties": {
              "failure_code": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            }
          },
          "else": {
            "properties": {
              "failure_code": {
                "enum": [
                  "",
                  null
                ]
              }
            }
          }
        }
      ]
    },
    "CommandMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "filename",
        "content_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "ref": {
          "const": "command"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CommandMessageText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "media"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "media": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
    },
    "CommandMessageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "media"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/CommandMedia"
          }
        }
      }
    },
    "AdapterCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "command_id",
        "recipient",
        "route_version",
        "created_at",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "chatballs.api-connector.command.v1"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "command_id": {
          "$ref": "#/$defs/UUID"
        },
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "external_chat_id",
            "external_user_id"
          ],
          "properties": {
            "external_chat_id": {
              "$ref": "#/$defs/Identifier128"
            },
            "external_user_id": {
              "$ref": "#/$defs/Identifier128"
            }
          }
        },
        "route_version": {
          "const": "source-scoped-route-v1"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "oneOf": [
            {
              "$ref": "#/$defs/CommandMessageText"
            },
            {
              "$ref": "#/$defs/CommandMessageFile"
            }
          ]
        }
      }
    },
    "CommandAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "id"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "id": {
          "$ref": "#/$defs/UUID"
        }
      },
      "description": "Adapter acknowledgment of durable command acceptance; not provider delivery."
    },
    "AcceptedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "id"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "id": {
          "$ref": "#/$defs/Identifier256"
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
